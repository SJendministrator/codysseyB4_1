# =============================================================
# agent-app 실행 환경 변수 (단일 원본)
#
# 이 파일 하나를 기준으로
#   - 로그인 셸:   /etc/profile.d/agent-app.sh 로 복사 (setup/04_app_env.sh)
#   - cron:       monitor.sh 가 직접 source (cron 은 로그인 셸 설정을 안 읽음)
# 두 곳이 같은 값을 쓰도록 한다.
# =============================================================
export AGENT_HOME=/home/agent-admin/agent-app
export AGENT_PORT=15034
export AGENT_UPLOAD_DIR="$AGENT_HOME/upload_files"
# 미션 문서는 파일 경로(.../t_secret.key)로 안내하지만, 제공 앱은 "디렉터리"를 기대한다.
#   [2/5] ... Key Path Mismatch. Expected: /home/agent-admin/agent-app/api_keys
# 키 파일(t_secret.key)은 이 디렉터리 안에 둔다.
export AGENT_KEY_PATH="$AGENT_HOME/api_keys"
export AGENT_LOG_DIR=/var/log/agent-app
